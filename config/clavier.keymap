        lower_layer {
            bindings = <
                &none  &none  &none  &none  &none  &none  &kp N7  &kp N8  &kp N9  &none  &bootloader  &none  &none  &none  &none  &none  &none  &kp N4  &kp N5  &kp N6  &none  &none  &none  &none  &none  &none  &none  &none  &kp N1  &kp N2  &kp N3  &none  &none  &none  &none  &none  &none  &none  &trans  &kp N0  &kp DOT  &trans  &trans  &trans
